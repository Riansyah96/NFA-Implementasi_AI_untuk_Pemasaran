        "sendTo": "={{ $json.email_klien }}",
        "subject": "=Invoice {{ $json.nomor_invoice }} - {{ $json.nama_klien }}",
        "message": "=<div style='font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #222;'>\n<p>Halo <strong>{{ $json.nama_klien }}</strong>,</p>\n<p>Terima kasih telah menggunakan jasa kami. Berikut kami lampirkan invoice <strong>{{ $json.nomor_invoice }}</strong> dalam format PDF.</p>\n<ul>\n  <li>Jam kerja: {{ $json.jam_kerja }} jam</li>\n  <li>Rate per jam: {{ $json.rate_format }}</li>\n  <li>Total biaya: <strong>{{ $json.total_biaya }}</strong></li>\n</ul>\n<p>Jika ada pertanyaan terkait tagihan ini, silakan balas email ini kapan saja.</p>\n<p>Salam hangat,<br>Tim Kami</p>\n</div>",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
