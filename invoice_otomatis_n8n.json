    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang='id'>\n<head>\n<meta charset='UTF-8'>\n<title>{{ $json.nomor_invoice }}</title>\n<style>\n  body { font-family: Arial, Helvetica, sans-serif; color: #222; margin: 0; padding: 40px; font-size: 14px; }\n  .header { display: table; width: 100%; border-bottom: 3px solid #1f4e79; padding-bottom: 16px; margin-bottom: 28px; }\n  .header .left, .header .right { display: table-cell; vertical-align: top; }\n  .header .right { text-align: right; }\n  h1 { margin: 0; color: #1f4e79; font-size: 32px; letter-spacing: 2px; }\n  .muted { color: #666; }\n  .box { background: #f4f7fa; padding: 14px 18px; border-radius: 6px; margin-bottom: 28px; }\n  table { width: 100%; border-collapse: collapse; }\n  th { background: #1f4e79; color: #fff; text-align: left; padding: 10px; }\n  td { padding: 10px; border-bottom: 1px solid #ddd; }\n  .num { text-align: right; }\n  .total td { border-bottom: none; font-size: 16px; font-weight: bold; background: #eaf1f8; }\n  .footer { margin-top: 48px; text-align: center; color: #888; font-size: 12px; }\n</style>\n</head>\n<body>\n  <div class='header'>\n    <div class='left'>\n      <h1>INVOICE</h1>\n      <div class='muted'>Jasa Profesional</div>\n    </div>\n    <div class='right'>\n      <div><strong>{{ $json.nomor_invoice }}</strong></div>\n      <div class='muted'>Tanggal: {{ $json.tanggal_invoice }}</div>\n    </div>\n  </div>\n\n  <div class='box'>\n    <div class='muted'>Ditagihkan kepada:</div>\n    <div style='font-size:18px; font-weight:bold;'>{{ $json.nama_klien }}</div>\n    <div class='muted'>{{ $json.email_klien }}</div>\n  </div>\n\n  <table>\n    <thead>\n      <tr>\n        <th>Deskripsi</th>\n        <th class='num'>Jam Kerja</th>\n        <th class='num'>Rate per Jam</th>\n        <th class='num'>Subtotal</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>Jasa profesional</td>\n        <td class='num'>{{ $json.jam_kerja }} jam</td>\n        <td class='num'>{{ $json.rate_format }}</td>\n        <td class='num'>{{ $json.total_biaya }}</td>\n      </tr>\n      <tr class='total'>\n        <td colspan='3' class='num'>TOTAL BIAYA</td>\n        <td class='num'>{{ $json.total_biaya }}</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <div class='footer'>Terima kasih atas kepercayaan Anda. Mohon lakukan pembayaran sesuai nominal di atas.</div>\n</body>\n</html>"
      },
      "id": "dea2121d-3526-4470-b88f-3b33ee58cfb9",
