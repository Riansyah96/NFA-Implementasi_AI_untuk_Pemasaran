    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const inv = $('Edit Fields').item.json;\nconst binary = $input.item.binary;\n\nbinary.data.fileName = `${inv.nomor_invoice}.pdf`;\nbinary.data.mimeType = 'application/pdf';\nbinary.data.fileExtension = 'pdf';\n\nreturn { json: { ...inv }, binary };"
      },
