    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Ambil output teks dari LLM Chain\nconst llmOutput = String($json.text || '');\n// Data email asli dari Gmail Trigger\nconst email = $('Gmail Trigger').item.json;\n\n// Regex: cari \"Skor: <angka>\" (spasi opsional)\nconst match = llmOutput.match(/Skor:\\s*(\\d+)/i);\n\nlet score = 0;\nif (match && match[1]) {\n  score = parseInt(match[1], 10);\n}\n// Batasi ke rentang 0-10\nscore = Math.min(Math.max(score, 0), 10);\n\n// Bersihkan karakter yang dapat merusak format pesan Telegram\nconst clean = (s) => String(s || '').replace(/[<>_*`\\[\\]]/g, ' ');\n\nreturn {\n  json: {\n    score,\n    parsed: Boolean(match),\n    messageId: email.id,\n    from: clean(email.From),\n    subject: clean(email.Subject),\n    llmOutput\n  }\n};"
      },
